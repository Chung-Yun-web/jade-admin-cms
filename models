import mongoose from "mongoose";

const SeriesSchema = new mongoose.Schema({
  originalId: { type: String, required: true },
  name: { type: String, required: true },
  englishName: { type: String },
  description: { type: String },
  image: { type: String },
  tabs: [{
    tabKey: { type: String },
    tabLabel: { type: String },
    header: {
      title: { type: String },
      description: { type: String }
    },
    craftId: { type: String },
    features: [{
      title: { type: String },
      description: { type: String }
    }]
  }],
  seriesStyle: { type: mongoose.Schema.Types.Mixed },
  moodNotes: { type: mongoose.Schema.Types.Mixed },
  outfitPhilosophy: { type: mongoose.Schema.Types.Mixed }
}, { timestamps: true });

export default mongoose.models.Series || mongoose.model("Series", SeriesSchema);
